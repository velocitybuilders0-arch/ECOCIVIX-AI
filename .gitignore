# ECOCIVIX AI Root GitIgnore

# Server build & node_modules
server/node_modules/
server/dist/
server/.env
.env
.env.local
.env.*.local

# Python / ML Service artifacts
__pycache__/
*.pyc
.pytest_cache/
ml-service/models/*
!ml-service/models/.gitkeep
ml-service/.env
mobile/.env

# System & IDE files
.DS_Store
*.log
